            --amber-deep: #E08E14;
            --ink: #0E0E10;
            --ink-2: #1A1A1E;
            --ink-3: #2A2A30;
            --paper: #FAF7F2;
            --white: #FFFFFF;
            --muted: #5E5E66;
            --muted-dark: #A6A6AE;
            --line: #E8E3DA;
            --radius: 20px;
            --max: 1200px;
            --display: 'Plus Jakarta Sans', system-ui, sans-serif;
