        .eyebrow::before { content: ""; width: 24px; height: 3px; border-radius: 2px; background: var(--amber); }
        .section { padding: 112px 0; }
        .section-head { max-width: 720px; margin-bottom: 56px; }
        .section-head h2 { font-size: clamp(32px, 4.4vw, 52px); margin-top: 16px; }
        .section-head p { margin-top: 18px; color: var(--muted); font-size: 19px; }

        /* Buttons */
        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 10px;
            padding: 15px 26px; border-radius: 999px;
            font-weight: 600; font-size: 16px; line-height: 1;
            border: 2px solid transparent;
            transition: transform .2s ease, background .2s ease, color .2s ease, border-color .2s ease;
            white-space: nowrap;
        }
        .btn:hover { transform: translateY(-2px); }
        .btn svg { width: 18px; height: 18px; transition: transform .2s ease; }
        .btn:hover svg { transform: translateX(3px); }
        .btn-amber { background: var(--amber); color: var(--ink); }
        .btn-amber:hover { background: #F7BC63; }
        .btn-dark { background: var(--ink); color: var(--white); }
        .btn-dark:hover { background: var(--ink-3); }
        .btn-ghost-light { border-color: rgba(255,255,255,.35); color: var(--white); }
        .btn-ghost-light:hover { border-color: var(--white); }
        .btn-ghost-dark { border-color: var(--ink); color: var(--ink); }
        .btn-ghost-dark:hover { background: var(--ink); color: var(--white); }
        .btn-sm { padding: 11px 20px; font-size: 15px; }

        /* Header */
        .site-header {
            position: sticky; top: 0; z-index: 50;
            background: rgba(255,255,255,.92);
            backdrop-filter: saturate(180%) blur(12px);
            -webkit-backdrop-filter: saturate(180%) blur(12px);
            border-bottom: 1px solid transparent;
            transition: border-color .2s ease;
        }
        .site-header.scrolled { border-bottom-color: var(--line); }
        .nav { display: flex; align-items: center; justify-content: space-between; height: 76px; gap: 24px; }
        .brand { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 800; font-size: 20px; letter-spacing: -0.02em; }
        .brand img { width: 38px; height: 38px; object-fit: contain; }
        .nav-links { display: flex; align-items: center; gap: 32px; list-style: none; margin: 0; padding: 0; }
        .nav-links a { font-size: 15px; font-weight: 500; color: var(--muted); transition: color .2s; }
        .nav-links a:hover { color: var(--ink); }
        .nav-actions { display: flex; align-items: center; gap: 18px; }
        .nav-actions .login { font-size: 15px; font-weight: 600; }
        .menu-toggle { display: none; background: none; border: 0; padding: 8px; cursor: pointer; color: var(--ink); }
        .menu-toggle svg { width: 26px; height: 26px; }
        .mobile-menu { display: none; }

        /* Hero */
        .hero { background: var(--ink); color: var(--white); position: relative; overflow: hidden; }
        .hero::before {
            content: ""; position: absolute; width: 720px; height: 720px; right: -220px; top: -260px;
            background: radial-gradient(circle, rgba(244,170,62,.22), transparent 65%);
            pointer-events: none;
        }
        .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center; padding: 96px 0 112px; position: relative; }
        .hero .eyebrow { color: var(--amber); }
        .hero h1 { font-size: clamp(42px, 6vw, 76px); margin-top: 22px; font-weight: 800; }
        .hero h1 em { font-style: normal; color: var(--amber); }
        .hero-lead { margin-top: 26px; font-size: 20px; color: var(--muted-dark); max-width: 540px; }
        .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 40px; }
        .hero-note { margin-top: 28px; font-size: 14px; color: var(--muted-dark); display: flex; align-items: center; gap: 10px; }
        .hero-note .dot { width: 8px; height: 8px; border-radius: 50%; background: #3DDC84; box-shadow: 0 0 0 4px rgba(61,220,132,.18); }

        .hero-visual { position: relative; }
        .hero-photo { border-radius: 28px; overflow: hidden; aspect-ratio: 4 / 4.4; }
        .hero-photo img { width: 100%; height: 100%; object-fit: cover; }
        .hero-bar {
            position: absolute; left: -28px; top: 48px; width: 14px; height: 140px;
            border-radius: 8px; background: var(--amber);
        }
        .float-card {
            position: absolute; background: var(--white); color: var(--ink);
            border-radius: 16px; padding: 16px 18px;
            box-shadow: 0 24px 48px -12px rgba(0,0,0,.45);
            display: flex; align-items: center; gap: 14px;
        }
        .float-card .icon {
            width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
            background: var(--paper); display: grid; place-items: center; color: var(--amber-deep);
        }
        .float-card .icon svg { width: 22px; height: 22px; }
        .float-card strong { display: block; font-family: var(--display); font-size: 15px; }
        .float-card span { font-size: 13px; color: var(--muted); }
        .float-card.one { left: -40px; bottom: 56px; }
        .float-card.two { right: -24px; top: 32px; }

        /* Facts strip */
        .facts { background: var(--paper); border-bottom: 1px solid var(--line); }
        .facts-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
        .fact { padding: 40px 28px; border-left: 1px solid var(--line); }
        .fact:first-child { border-left: 0; padding-left: 0; }
        .fact strong { display: block; font-family: var(--display); font-size: 36px; font-weight: 800; letter-spacing: -0.02em; }
        .fact strong .accent { color: var(--amber-deep); }
        .fact span { display: block; margin-top: 6px; color: var(--muted); font-size: 15px; line-height: 1.5; }

        /* Services */
        .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
        .service {
            border: 1px solid var(--line); border-radius: var(--radius); padding: 36px 32px;
            background: var(--white); transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
            display: flex; flex-direction: column;
        }
        .service:hover { transform: translateY(-6px); box-shadow: 0 24px 48px -24px rgba(14,14,16,.25); border-color: transparent; }
        .service .num { font-family: var(--display); font-weight: 700; font-size: 14px; color: var(--amber-deep); }
        .service h3 { font-size: 26px; margin-top: 56px; }
        .service p { margin-top: 14px; color: var(--muted); }
        .service ul { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 10px; font-size: 15px; }
        .service li { display: flex; gap: 10px; align-items: flex-start; }
        .service li::before { content: ""; flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--amber); margin-top: 9px; }

        /* Audiences */
        .audiences { background: var(--paper); }
        .audience-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
        .audience { border-radius: 28px; overflow: hidden; display: flex; flex-direction: column; }
        .audience.companies { background: var(--ink); color: var(--white); }
        .audience.talent { background: var(--amber); color: var(--ink); }
        .audience-photo { aspect-ratio: 16 / 9; overflow: hidden; }
        .audience-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
        .audience:hover .audience-photo img { transform: scale(1.04); }
        .audience-body { padding: 40px; display: flex; flex-direction: column; flex: 1; }
        .audience-body .tag { font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; opacity: .7; }
        .audience-body h3 { font-size: clamp(28px, 3vw, 36px); margin-top: 12px; }
        .audience-body p { margin-top: 14px; opacity: .8; }
        .audience-body ul { list-style: none; padding: 0; margin: 24px 0 32px; display: grid; gap: 12px; }
        .audience-body li { display: flex; gap: 12px; align-items: flex-start; }
        .audience-body li svg { width: 20px; height: 20px; flex-shrink: 0; margin-top: 3px; }
        .audience.companies li svg { color: var(--amber); }
        .audience-body .btn { margin-top: auto; align-self: flex-start; }

        /* Steps */
        .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; counter-reset: step; position: relative; }
        .steps::before {
            content: ""; position: absolute; top: 28px; left: 28px; right: 28px; height: 2px;
            background: repeating-linear-gradient(90deg, var(--line) 0 8px, transparent 8px 16px);
        }
        .step { position: relative; }
        .step .badge {
            width: 56px; height: 56px; border-radius: 50%;
            background: var(--white); border: 2px solid var(--ink);
            display: grid; place-items: center; position: relative;
            font-family: var(--display); font-weight: 800; font-size: 18px;
        }
        .step:last-child .badge { background: var(--amber); border-color: var(--amber); }
        .step h3 { font-size: 22px; margin-top: 28px; }
        .step p { margin-top: 10px; color: var(--muted); font-size: 16px; }

        /* Story */
        .story { background: var(--ink); color: var(--white); }
        .story-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 72px; align-items: center; }
        .story-photo { border-radius: 28px; overflow: hidden; aspect-ratio: 4 / 5; position: relative; }
        .story-photo img { width: 100%; height: 100%; object-fit: cover; }
        .story .eyebrow { color: var(--amber); }
        .story blockquote {
            margin: 22px 0 0; font-family: var(--display); font-weight: 700;
            font-size: clamp(28px, 3.4vw, 42px); line-height: 1.2; letter-spacing: -0.02em;
        }
        .story blockquote em { font-style: normal; color: var(--amber); }
        .story-text { margin-top: 28px; color: var(--muted-dark); display: grid; gap: 18px; }
        .pillars { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 40px; }
        .pillar { border: 1px solid var(--ink-3); border-radius: 16px; padding: 22px; background: var(--ink-2); }
        .pillar strong { display: block; font-family: var(--display); color: var(--amber); font-size: 14px; letter-spacing: .08em; text-transform: uppercase; }
        .pillar span { display: block; margin-top: 8px; font-size: 15px; color: #D6D6DC; line-height: 1.55; }

        /* Testimonials */
        .testimonials-track {
            display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 48px) / 3);
            gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px;
            scrollbar-width: thin;
        }
        .testimonial {
            margin: 0; scroll-snap-align: start; background: var(--paper); border-radius: var(--radius);
            padding: 36px; display: flex; flex-direction: column; gap: 28px;
        }
        .testimonial .quote-mark { font-family: var(--display); font-size: 64px; line-height: .6; color: var(--amber); height: 28px; }
        .testimonial p { font-size: 18px; line-height: 1.6; flex: 1; }
        .testimonial footer { display: flex; align-items: center; gap: 14px; }
        .testimonial footer img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
        .testimonial .avatar-fallback {
            width: 52px; height: 52px; border-radius: 50%; background: var(--ink); color: var(--amber);
            display: grid; place-items: center; font-family: var(--display); font-weight: 700; font-size: 20px;
        }
        .testimonial footer strong { display: block; font-family: var(--display); }
        .testimonial footer span { font-size: 14px; color: var(--muted); }

        /* CTA */
        .cta { padding: 0 0 112px; }
        .cta-box {
            background: var(--amber); border-radius: 32px; padding: 80px 64px;
            display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center;
            position: relative; overflow: hidden;
        }
        .cta-box::after {
            content: ""; position: absolute; right: -60px; bottom: -120px; width: 320px; height: 320px;
            border-radius: 50%; border: 48px solid rgba(14,14,16,.06);
        }
        .cta-box h2 { font-size: clamp(32px, 4.4vw, 52px); font-weight: 800; }
        .cta-box p { margin-top: 16px; font-size: 19px; max-width: 520px; }
        .cta-actions { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; position: relative; z-index: 1; }

        /* Footer */
        .site-footer { background: var(--ink); color: var(--muted-dark); padding: 80px 0 40px; font-size: 15px; }
        .footer-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 48px; }
        .footer-brand .brand { color: var(--white); }
        .footer-brand .brand img { background: var(--white); border-radius: 10px; padding: 4px; }
        .footer-brand p { margin-top: 18px; max-width: 320px; }
        .site-footer h4 { color: var(--white); font-family: var(--display); font-size: 15px; margin: 0 0 18px; }
        .site-footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
        .site-footer a:hover { color: var(--amber); }
        .footer-bottom { margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--ink-3); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 14px; }
        .footer-bottom nav { display: flex; gap: 24px; flex-wrap: wrap; }

        /* Reveal on scroll */
        .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
        .reveal.in { opacity: 1; transform: none; }
        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .reveal { opacity: 1; transform: none; transition: none; }
            .btn, .service, .audience-photo img { transition: none; }
        }

        /* Responsive */
        @media (max-width: 1080px) {
            .nav-links { gap: 22px; }
            .float-card.one { left: 16px; }
            .float-card.two { right: 16px; }
            .hero-bar { display: none; }
        }
        @media (max-width: 960px) {
            .nav-links, .nav-actions .login, .nav-actions .btn { display: none; }
            .menu-toggle { display: inline-flex; }
            .mobile-menu.open {
                display: grid; gap: 4px; padding: 8px 24px 24px; border-top: 1px solid var(--line); background: var(--white);
            }
            .mobile-menu a { padding: 12px 0; font-weight: 500; border-bottom: 1px solid var(--line); }
            .mobile-menu .btn { margin-top: 16px; border-bottom: 0; padding: 15px 26px; }

            .hero-grid, .story-grid, .cta-box { grid-template-columns: 1fr; }
            .hero-grid { padding: 64px 0 80px; gap: 48px; }
            .hero-photo { aspect-ratio: 4 / 3; }
            .facts-grid { grid-template-columns: 1fr 1fr; }
            .fact { padding: 28px 20px; }
            .fact:nth-child(3) { border-left: 0; padding-left: 0; }
            .fact:nth-child(n+3) { border-top: 1px solid var(--line); }
            .services-grid, .audience-grid { grid-template-columns: 1fr; }
            .service h3 { margin-top: 28px; }
            .steps { grid-template-columns: 1fr 1fr; row-gap: 48px; }
            .steps::before { display: none; }
            .story-photo { aspect-ratio: 4 / 3; }
            .footer-grid { grid-template-columns: 1fr 1fr; }
            .footer-brand { grid-column: 1 / -1; }
            .testimonials-track { grid-auto-columns: calc((100% - 24px) / 2); }
            .cta-box { padding: 56px 40px; }
        }
        @media (max-width: 600px) {
            body { font-size: 16px; }
            .container { padding: 0 16px; }
            .section { padding: 80px 0; }
            .hero-lead { font-size: 18px; }
            .hero-ctas .btn { flex: 1 1 100%; }
            .float-card { padding: 12px 14px; }
            .float-card.two { display: none; }
            .float-card.one { left: 12px; bottom: 12px; right: 12px; }
            .fact strong { font-size: 28px; }
            .steps { grid-template-columns: 1fr; }
            .pillars { grid-template-columns: 1fr; }
            .audience-body { padding: 28px; }
            .testimonials-track { grid-auto-columns: 85%; }
            .testimonial { padding: 28px; }
            .cta-box { padding: 44px 24px; border-radius: 24px; }
            .footer-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
